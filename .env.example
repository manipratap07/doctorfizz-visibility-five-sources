# VPS runtime (keep existing .env values on upgrade)
APP_URL=https://visibility-checker.itzfizz.com
# Other frontends allowed to call this backend (comma-separated origins).
ALLOWED_ORIGINS=https://doctorfizz-visibility.vercel.app
DATABASE_URL=postgresql://doctorfizz:CHANGE_ME@postgres:5432/doctorfizz
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379
IP_HASH_SALT=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TRUSTED_IP_HEADER=x-doctorfizz-proxy-ip
BACKEND_AUTH_REQUIRED=true
BACKEND_SHARED_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# On VPS leave empty. On Vercel use the HTTPS backend origin.
BACKEND_URL=
DOCTORFIZZ_WEB_PORT=8089
FREE_ATTEMPTS=5
WINDOW_DAYS=30
IP_DAILY_CAP=15
DOMAIN_DAILY_CAP=10
MAX_PENDING_CHECKS=1
# Residential proxy for the browser worker. Use the provider's http:// gateway
# (Chromium cannot authenticate to SOCKS). Put {session} where the provider expects
# a sticky-session id, e.g. http://user-session-{session}:PASS@gate.example.com:7000
RESIDENTIAL_PROXY_URL=
# true = every run refuses to browse without the proxy (recommended on the VPS);
# the run fails with a clear reason and the check is refunded.
REQUIRE_PROXY=true
# Browser fingerprint must match the proxy's country.
BROWSER_LOCALE=en-IN
BROWSER_TIMEZONE=Asia/Kolkata
BROWSER_HEADLESS=false
BROWSER_BLOCK_RETRIES=1
# Disable any site that fails its VPS acceptance probe (comma-separated IDs).
BROWSER_DISABLED_PROVIDERS=
HEALTH_CHECK_ENABLED=false
# Optional existing bot verification; no external credentials needed by default.
TURNSTILE_REQUIRED=false
