# VPS runtime (keep existing .env values on upgrade)
APP_URL=https://doctorfizz-visibility.vercel.app
DATABASE_URL=postgresql://doctorfizz:CHANGE_ME@postgres:5432/doctorfizz
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379
IP_HASH_SALT=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TRUSTED_IP_HEADER=x-doctorfizz-proxy-ip
BACKEND_AUTH_REQUIRED=true
BACKEND_SHARED_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# On VPS leave empty. On Vercel use the HTTPS backend origin.
BACKEND_URL=
DOCTORFIZZ_WEB_PORT=8089
FREE_ATTEMPTS=5
WINDOW_DAYS=30
IP_DAILY_CAP=15
DOMAIN_DAILY_CAP=10
MAX_PENDING_CHECKS=1
# Disable any site that fails its VPS acceptance probe (comma-separated IDs).
BROWSER_DISABLED_PROVIDERS=
HEALTH_CHECK_ENABLED=false
# Optional existing bot verification; no external credentials needed by default.
TURNSTILE_REQUIRED=false

# Proxy routes are opt-in. Leave empty for direct browser access.
PROXY_PROVIDERS=
# Optional HTTP(S) proxy URL; encode reserved characters in credentials. Never commit real values.
RESIDENTIAL_PROXY_URL=
REQUIRE_PROXY=true
# Optional known public VPS address; fails closed when the observed exit matches it.
VPS_PUBLIC_IP=187.127.186.47
BROWSER_HEADLESS=false
BROWSER_TIMEZONE_ID=Asia/Kolkata
BROWSER_LOCALE=en-IN

# Optional authorised login state. Enable only after browser:login and a live probe.
# Session files live outside images/Git in browser-sessions/<provider>.json.
BROWSER_SESSION_PROVIDERS=
